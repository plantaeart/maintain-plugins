{
  "name": "maintain-plugins",
  "version": "0.6.1",
  "description": "Pi and OMP extension that checks installed plugin versions against npm and updates the stale ones safely, in one confirmed step",
  "type": "module",
  "main": "extensions/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "omp",
    "oh-my-pi",
    "plugin-manager",
    "plugin-updater",
    "update-checker"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/plantaeart/maintain-plugins/main/assets/logo/cover.png"
  },
  "extensions": [
    "./extensions"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "validate:skills": "bash .agents/skills/ci-check/scripts/validate-skills.sh",
    "ci": "bun run lint && bun run typecheck && bun test && bun run validate:skills"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "bun-types": "^1.4.2",
    "oxlint": "^1.85.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plantaeart/maintain-plugins.git"
  },
  "homepage": "https://github.com/plantaeart/maintain-plugins#readme",
  "bugs": {
    "url": "https://github.com/plantaeart/maintain-plugins/issues"
  }
}
